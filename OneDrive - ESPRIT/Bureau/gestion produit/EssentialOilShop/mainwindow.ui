/* ========== GLOBAL STYLES ========== */
QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 12px;
}

QWidget#centralwidget {
    background-color: #E7F2D7;
}

/* ========== SIDEBAR STYLES ========== */
QWidget#sidebarWidget {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5D7A4A, stop:0.5 #527042, stop:1 #46613A);
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QWidget#sidebarWidget QLabel {
    color: #FFFFFF;
    background-color: transparent;
    border: none;
}

QWidget#sidebarWidget QPushButton {
    color: rgba(255, 255, 255, 220);
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 11px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    margin-left: 4px;
    margin-right: 4px;
}

QWidget#sidebarWidget QPushButton:hover {
    background-color: rgba(255, 255, 255, 30);
    color: #FFFFFF;
}

QWidget#sidebarWidget QPushButton:pressed {
    background-color: rgba(0, 0, 0, 40);
}

QWidget#sidebarWidget QPushButton:checked {
    background-color: rgba(184, 216, 158, 0.92);
    color: #1b3714;
    border: none;
    border-radius: 12px;
    padding: 11px 16px;
    font-weight: 700;
}

QWidget#sidebarWidget QPushButton:checked:hover {
    background-color: rgba(184, 216, 158, 1.0);
}

QWidget#sidebarWidget QPushButton#btnAdmin {
    background-color: rgba(255,255,255,20);
    color: rgba(255,255,255,220);
    border-radius: 14px;
    padding: 10px 16px;
}

QWidget#sidebarWidget QPushButton#btnAdmin:hover {
    background-color: rgba(255,255,255,40);
}

QWidget#sidebarWidget QPushButton#btnAdmin:checked {
    background-color: rgba(184,216,158,0.92);
    color: #1b3714;
}

/* Admin button is styled above with other sidebar buttons */

QLabel#appTitle {
    color: #FFFFFF;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#appSubtitle {
    color: rgba(212, 232, 196, 180);
    font-size: 10px;
    font-weight: 400;
}

QLabel#navLabel {
    color: rgba(200, 222, 184, 160);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    padding-left: 4px;
}

QFrame#sidebarSeparator {
    background-color: rgba(255, 255, 255, 30);
    border: none;
    max-height: 1px;
    min-height: 1px;
    margin-left: 8px;
    margin-right: 8px;
}

/* ========== CONTENT AREA STYLES ========== */
QLabel#pageTitle {
    color: #2F3E1E;
    font-size: 24px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #5D6C4C;
    font-size: 13px;
}

/* ========== CARD STYLES ========== */
QFrame#formCard {
    background-color: #F5FAF0;
    border: 1px solid #D0E0C0;
    border-radius: 16px;
}

QFrame#tableCard {
    background-color: #F5FAF0;
    border: 1px solid #D0E0C0;
    border-radius: 16px;
}

QLabel#cardTitle {
    color: #2F3E1E;
    font-size: 16px;
    font-weight: 700;
}

QLabel#cardSubtitle {
    color: #6B7A5A;
    font-size: 11px;
}

/* ========== FORM STYLES ========== */
QLabel#formLabel {
    color: #3A4A2A;
    font-size: 12px;
    font-weight: 600;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C0D4B0;
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 20px;
    color: #2F3E1E;
    font-size: 12px;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #8FB07A;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #6B9A55;
    background-color: #FAFDF7;
}

QLineEdit::placeholder {
    color: #9AAA8A;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #C0D4B0;
    border-radius: 8px;
    padding: 10px;
    color: #2F3E1E;
    font-size: 12px;
}

QTextEdit:focus {
    border: 2px solid #6B9A55;
}

/* ========== BUTTON STYLES ========== */
QPushButton#btnAdd {
    background-color: #6B9A55;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 100px;
}

QPushButton#btnAdd:hover {
    background-color: #5A8A45;
}

QPushButton#btnAdd:pressed {
    background-color: #4A7A35;
}

QPushButton#btnModify {
