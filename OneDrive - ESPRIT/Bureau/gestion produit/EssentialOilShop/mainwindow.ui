    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 100px;
}

QPushButton#btnModify:hover {
    background-color: #4A8BC5;
}

QPushButton#btnModify:pressed {
    background-color: #3A7BB5;
}

QPushButton#btnDelete {
    background-color: #E07070;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 100px;
}

QPushButton#btnDelete:hover {
    background-color: #D06060;
}

QPushButton#btnDelete:pressed {
    background-color: #C05050;
}

QPushButton#btnClear {
    background-color: #F0F5EA;
    color: #5D6C4C;
    border: 1px solid #C0D4B0;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 100px;
}

QPushButton#btnClear:hover {
    background-color: #E5EDE0;
    border-color: #A0C490;
}

QPushButton#btnRefresh {
    background-color: #F0F5EA;
    color: #5D6C4C;
    border: 1px solid #C0D4B0;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#btnRefresh:hover {
    background-color: #E5EDE0;
}

/* ========== TABLE STYLES ========== */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F5FAF0;
    border: 1px solid #D0E0C0;
    border-radius: 10px;
    gridline-color: #E0EED0;
    selection-background-color: #7A9E64;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #E8F0E0;
}

QTableWidget::item:hover {
    background-color: #E8F5E0;
}

QHeaderView::section {
    background-color: #E0EED0;
    color: #2F3E1E;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #C0D4B0;
    font-weight: 600;
    font-size: 12px;
}

QTableWidget QTableCornerButton::section {
    background-color: #E0EED0;
    border: none;
}

/* ========== STATISTICS CARDS ========== */
QFrame#statCard {
    background-color: #F5FAF0;
    border: 1px solid #D0E0C0;
    border-radius: 12px;
}

QLabel#statValue {
    color: #2F3E1E;
    font-size: 24px;
    font-weight: 700;
}

QLabel#statLabel {
    color: #6B7A5A;
    font-size: 11px;
}

QLabel#statDotGreen {
    background-color: #6B9A55;
    border-radius: 6px;
}

QLabel#statDotBlue {
    background-color: #5A9BD5;
    border-radius: 6px;
}

QLabel#statDotOrange {
    background-color: #E0A050;
    border-radius: 6px;
}

QLabel#statDotPurple {
    background-color: #9A7BD5;
    border-radius: 6px;
}

/* ========== STATISTICS BUTTON ========== */
QPushButton#btnStatistique {
    background-color: #9A7BD5;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
}

QPushButton#btnStatistique:hover {
    background-color: #8A6BC5;
}

QPushButton#btnStatistique:pressed {
    background-color: #7A5BB5;
}

/* ========== SEARCH AND SORT ========== */
QLineEdit#searchBar {
    background-color: #FFFFFF;
    border: 1px solid #C0D4B0;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 18px;
    color: #2F3E1E;
    font-size: 12px;
    min-width: 200px;
}

QLineEdit#searchBar:focus {
    border: 2px solid #6B9A55;
    background-color: #FAFDF7;
}

QComboBox#comboSort {
    background-color: #FFFFFF;
    border: 1px solid #C0D4B0;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 18px;
    color: #2F3E1E;
    font-size: 12px;
    min-width: 160px;
}

QComboBox#comboSort:focus {
    border: 2px solid #6B9A55;
}

/* ========== SCROLLBAR STYLES ========== */
QScrollBar:vertical {
    background-color: #F0F5EA;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #C0D4B0;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A0C490;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
